{
    "ip": "127.0.0.1",
    "nodes": [
        {
            "name": "user",
            "interfaces": [
                { "face": "face0", "port": "/dev/tty.usbserial-AI02Z6GB" }
            ],
            "FIB": {
                "/dlsu/goks/cam": { "face": "face0", "port": "/dev/tty.usbserial-AI02Z6GL" }
            },
            "storage": "client_node/storage/"
        },

        {
            "name": "/dlsu/goks/cam",
            "interfaces": [
                { "face": "face0", "port": "/dev/tty.usbserial-AI02Z6DU" }
            ],
            "FIB": {
            },
            "storage": "goks_cam_node/captures/",
            "node_functions_mapping": {
                "/dlsu/goks/cam": ["insightface_embedding", "facenet_embedding", "normalize", "orchestrate", "recognize", "detect", 
                                    "resize_facenet", "resize_mfn", "resize_insightface", "mfn_embedding", "grayscale"]
            }
        }
    ]
}